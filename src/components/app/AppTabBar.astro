---
// Bottom tab bar for the native apps, in place of the website's menu.
// Rendered only by `npm run build:native` (see PageFrame).
import { appSections, sectionFor } from "@/lib/appSections";

const path = Astro.url.pathname.replace(/\/?$/, "/");
const current = sectionFor(path);
---

<nav class="app-tabbar" aria-label="Sections">
  <ul>
    {
      appSections.map(({ slug, tab }) => {
        const href = slug ? `/${slug}/` : "/";
        const active = slug === current;
        return (
          <li>
            <a
              href={href}
              class:list={{ active }}
              aria-current={path === href ? "page" : undefined}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {slug === "" && (
                  <path class="fill" d="M3.5 10.2 12 3.2l8.5 7V20a1 1 0 0 1-1 1H15v-6.5H9V21H4.5a1 1 0 0 1-1-1Z" />
                )}
                {slug === "calculators" && (
                  <>
                    <rect class="fill" x="5" y="2.5" width="14" height="19" rx="2.5" />
                    <rect x="8" y="5.5" width="8" height="4" rx="1" />
                    <path d="M8.5 13.5h.01M12 13.5h.01M15.5 13.5h.01M8.5 17.5h.01M12 17.5h.01M15.5 17.5h.01" class="dots" />
                  </>
                )}
                {slug === "operator-reference" && (
                  <>
                    <path class="fill" d="M5 5a2 2 0 0 1 2-2h12v15H7a2 2 0 0 0-2 2Z" />
                    <path d="M5 20a2 2 0 0 0 2 2h12v-4M9 7.5h6" />
                  </>
                )}
                {slug === "operator-math" && (
                  <>
                    <circle class="fill" cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 12l-4.5 7.8M12 12l4.5 7.8" />
                  </>
                )}
              </svg>
              <span>{tab}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .app-tabbar {
    --tabbar-height: 3.25rem;

    position: fixed;
    inset: auto 0 0;
    z-index: var(--sl-z-index-navbar);
    padding-bottom: env(safe-area-inset-bottom);
    background-color: var(--sl-color-black);
    border-top: 1px solid var(--fg-line);
    font-family: var(--fg-font);
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 36rem;
    height: var(--tabbar-height);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0 !important;
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    height: 100%;
    color: var(--fg-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 120ms ease-out;
  }

  a:active {
    opacity: 0.55;
  }

  a:focus-visible {
    outline: 2px solid var(--fg-teal);
    outline-offset: -4px;
    border-radius: 0.5rem;
  }

  a.active {
    color: var(--fg-teal);
  }

  svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fill {
    fill: transparent;
  }

  a.active .fill {
    fill: currentColor;
    fill-opacity: 0.18;
  }

  .dots {
    stroke-width: 2.6;
  }

  /* Keep the last of the page clear of the bar. */
  :global(body) {
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom));
  }

  @media print {
    .app-tabbar {
      display: none;
    }
  }
</style>
