---
import {
  calculateDosage,
  chemicalPresets,
  flowUnits,
  formatNumber,
  type DosageInput,
} from "@/lib/dosage";
import "@/styles/calculator.css";

const initial: DosageInput = {
  dose: 6,
  flow: 4,
  flowUnit: "mgd",
  strength: 12.5,
  specificGravity: 1.2,
};

const outcome = calculateDosage(initial);
const r = outcome.ok ? outcome.result : null;
const f = (n: number | undefined) => (n === undefined ? "—" : formatNumber(n));
---

<section class="calc-page" aria-label="Chemical dosage calculator">
  <form class="calc" data-dosage-calc novalidate>
    <fieldset class="calc-inputs">
      <legend>Your numbers</legend>

      <label class="field field-wide">
        <span class="field-label">Chemical</span>
        <select name="preset">
          {
            chemicalPresets.map((p) => (
              <option value={p.id} selected={p.id === "hypo"}>
                {p.name} — {p.use}
              </option>
            ))
          }
          <option value="custom">Custom product</option>
        </select>
      </label>

      <label class="field">
        <span class="field-label">Target dose</span>
        <span class="field-input">
          <input name="dose" type="number" inputmode="decimal" min="0" step="any" value={initial.dose} />
          <span class="unit">mg/L</span>
        </span>
      </label>

      <div class="field">
        <label class="field-label" for="dosage-flow">Flow</label>
        <span class="field-input">
          <input id="dosage-flow" name="flow" type="number" inputmode="decimal" min="0" step="any" value={initial.flow} />
          <select name="flowUnit" aria-label="Flow unit" class="unit-select">
            {
              Object.entries(flowUnits).map(([id, u]) => (
                <option value={id} selected={id === initial.flowUnit}>
                  {u.label}
                </option>
              ))
            }
          </select>
        </span>
      </div>

      <label class="field">
        <span class="field-label">Product strength</span>
        <span class="field-input">
          <input name="strength" type="number" inputmode="decimal" min="0" max="100" step="any" value={initial.strength} />
          <span class="unit">%</span>
        </span>
      </label>

      <label class="field">
        <span class="field-label">Specific gravity</span>
        <span class="field-input">
          <input name="specificGravity" type="number" inputmode="decimal" min="0" step="any" value={initial.specificGravity} />
        </span>
      </label>

      <p class="field-hint field-wide">
        Preset strengths and specific gravities are typical values. Use the
        numbers on your product's label or SDS.
      </p>
    </fieldset>

    <div class="calc-results" aria-live="polite">
      <p class="calc-error" data-error hidden></p>

      <dl class="result-grid" data-results>
        <div class="result result-primary">
          <dt>Pump setting</dt>
          <dd><output data-out="productMlPerMin">{f(r?.productMlPerMin)}</output> <span>mL/min</span></dd>
        </div>
        <div class="result">
          <dt>Product per day</dt>
          <dd><output data-out="productGalPerDay">{f(r?.productGalPerDay)}</output> <span>gal/day</span></dd>
        </div>
        <div class="result">
          <dt>Product per hour</dt>
          <dd><output data-out="productGalPerHour">{f(r?.productGalPerHour)}</output> <span>gal/hr</span></dd>
        </div>
        <div class="result">
          <dt>Product weight</dt>
          <dd><output data-out="productLbPerDay">{f(r?.productLbPerDay)}</output> <span>lb/day</span></dd>
        </div>
        <div class="result">
          <dt>Active chemical</dt>
          <dd><output data-out="activeLbPerDay">{f(r?.activeLbPerDay)}</output> <span>lb/day</span></dd>
        </div>
      </dl>
    </div>
  </form>

  <section class="steps" aria-labelledby="steps-heading">
    <h2 id="steps-heading">Your numbers, step by step</h2>
    <ol class="step-list" data-steps>
      <li data-step="flow" hidden>
        <span class="step-what">Convert the flow to MGD</span>
        <span class="step-math" data-math="flow"></span>
      </li>
      <li>
        <span class="step-what">Pounds of active chemical</span>
        <span class="step-math" data-math="active">
          {initial.dose} mg/L × {f(r?.flowMgd)} MGD × 8.34 = <b>{f(r?.activeLbPerDay)} lb/day</b>
        </span>
      </li>
      <li data-step="strength">
        <span class="step-what">Scale up for product strength</span>
        <span class="step-math" data-math="strength">
          {f(r?.activeLbPerDay)} ÷ {initial.strength / 100} = <b>{f(r?.productLbPerDay)} lb/day</b> of product
        </span>
      </li>
      <li data-step="weight">
        <span class="step-what">Weight of one gallon of product</span>
        <span class="step-math" data-math="weight">
          8.34 × {initial.specificGravity} = <b>{r ? formatNumber(r.productLbPerGal, 2) : "—"} lb/gal</b>
        </span>
      </li>
      <li data-step="gallons">
        <span class="step-what">Gallons of product per day</span>
        <span class="step-math" data-math="gallons">
          {f(r?.productLbPerDay)} ÷ {r ? formatNumber(r.productLbPerGal, 2) : "—"} = <b>{f(r?.productGalPerDay)} gal/day</b>
        </span>
      </li>
      <li data-step="pump">
        <span class="step-what">Pump rate</span>
        <span class="step-math" data-math="pump">
          {f(r?.productGalPerDay)} gal/day × 3,785 mL/gal ÷ 1,440 min/day = <b>{f(r?.productMlPerMin)} mL/min</b>
        </span>
      </li>
    </ol>
  </section>

  <section class="prose" aria-labelledby="how-heading">
    <h2 id="how-heading">Why it works</h2>
    <p>
      The first step is the same multiplication as the <a href="/operator-math/davidson-pie-chart/">Davidson pie chart</a>:
      milligrams per liter times million gallons per day times 8.34 gives
      pounds per day. That answer is <strong>pure chemical</strong>, the amount
      the water needs to see.
    </p>
    <p>
      You are rarely pumping pure chemical. A drum of 12.5% hypochlorite is
      mostly water, so you have to move eight pounds of product to deliver one
      pound of chlorine. Dividing by the strength as a decimal makes that
      correction. The <a href="/operator-math/demand-strength-purity/">Demand,
      Strength and Purity</a> page walks through it in more detail.
    </p>
    <p>
      Pumps are set by volume, not weight, so the last move turns pounds into
      gallons. Liquid chemicals are heavier than water; specific gravity tells
      you by how much. A gallon of product weighs 8.34 × SG pounds.
    </p>
  </section>

  <section class="prose" aria-labelledby="example-heading">
    <h2 id="example-heading">Example: disinfecting plant effluent</h2>
    <p>
      Your plant discharges <strong>4.0 MGD</strong> and the chlorine contact
      chamber needs a <strong>6 mg/L</strong> dose to hold the residual your
      permit calls for. You feed <strong>12.5% sodium hypochlorite</strong> with a specific gravity of about <strong>1.2</strong>.
    </p>
    <ul class="example-math">
      <li>6 × 4.0 × 8.34 = <b>200.2 lb/day</b> of chlorine</li>
      <li>200.2 ÷ 0.125 = <b>1,601 lb/day</b> of hypochlorite solution</li>
      <li>1,601 ÷ (8.34 × 1.2 = 10.01 lb/gal) = <b>160 gal/day</b></li>
      <li>160 × 3,785 ÷ 1,440 = <b>420.6 mL/min</b> at the pump</li>
    </ul>
    <p>
      A 160 gal/day feed also tells you a 1,000-gallon tote lasts a little over
      six days. That is worth knowing before a holiday weekend.
    </p>
    <button type="button" class="load-example" data-load-example>
      Put this example in the calculator
    </button>
  </section>

  <section class="prose" aria-labelledby="sanity-heading">
    <h2 id="sanity-heading">Does the dose look reasonable?</h2>
    <p>
      Wastewater doses are set by a target, not picked from a table. Use these
      broad ranges as a sanity check on what you typed: if your number is far
      outside them, recheck the units and what the dose is expressed "as"
      before questioning the plant.
    </p>
    <div class="sanity-wrap">
      <table class="sanity">
        <thead>
          <tr>
            <th scope="col">Job</th>
            <th scope="col">Chemical</th>
            <th scope="col">What sets the dose</th>
            <th scope="col">Sanity range</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" data-label="Job">Effluent disinfection</th>
            <td data-label="Chemical">Sodium hypochlorite</td>
            <td data-label="What sets the dose">
              Residual and bacteria limits at the end of the contact tank
            </td>
            <td data-label="Sanity range">
              About 2–15 mg/L as Cl<sub>2</sub>; lower for filtered or
              nitrified effluent
            </td>
          </tr>
          <tr>
            <th scope="row" data-label="Job">Dechlorination</th>
            <td data-label="Chemical">Sodium bisulfite</td>
            <td data-label="What sets the dose">
              Chlorine residual leaving the contact tank
            </td>
            <td data-label="Sanity range">
              About 1.5–2 mg/L per 1 mg/L of Cl<sub>2</sub> residual
            </td>
          </tr>
          <tr>
            <th scope="row" data-label="Job">Phosphorus removal</th>
            <td data-label="Chemical">Ferric chloride</td>
            <td data-label="What sets the dose">
              Fe:P molar ratio, tuned by jar test and effluent TP
            </td>
            <td data-label="Sanity range">
              About 2.7–4.5 mg/L as Fe per 1 mg/L of P removed
            </td>
          </tr>
          <tr>
            <th scope="row" data-label="Job">Phosphorus removal</th>
            <td data-label="Chemical">Alum</td>
            <td data-label="What sets the dose">
              Al:P molar ratio, tuned by jar test and effluent TP
            </td>
            <td data-label="Sanity range">
              About 1.3–2.2 mg/L as Al per 1 mg/L of P removed
            </td>
          </tr>
          <tr>
            <th scope="row" data-label="Job">Alkalinity / pH</th>
            <td data-label="Chemical">Caustic soda</td>
            <td data-label="What sets the dose">
              pH or alkalinity target, often to support nitrification
            </td>
            <td data-label="Sanity range">
              About 0.8 mg/L NaOH per 1 mg/L of alkalinity (as CaCO<sub>3</sub>)
              added
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      For metal-salt doses written as Fe or Al, set the calculator's strength to
      the metal content, not the product strength: 40% ferric chloride is
      roughly 13.8% Fe, and 48.5% liquid alum is roughly 4.4% Al. Check your
      supplier's certificate of analysis for the exact figure.
    </p>
  </section>

  <section class="prose" aria-labelledby="checks-heading">
    <h2 id="checks-heading">Before you touch the pump</h2>
    <ul class="checks">
      <li>
        <strong>Match the flow units.</strong> SCADA often reads gpm; the
        formula wants MGD. Pick the unit above instead of converting in your
        head.
      </li>
      <li>
        <strong>Dose is not residual.</strong> Chlorine demand eats part of what
        you add. If the sample tap reads 1.0 mg/L, the dose was higher; size
        the feed on the dose.
      </li>
      <li>
        <strong>Know what the dose is "as."</strong> A phosphorus-removal dose
        written as mg/L Fe or mg/L Al is not the same as mg/L of product. Use
        the strength that matches how the dose is expressed.
      </li>
      <li>
        <strong>Bleach loses strength.</strong> Hypochlorite breaks down with
        heat and time, so an old tote delivers less than its label. If the
        residual is drifting down at a steady pump rate, suspect the product.
      </li>
      <li>
        <strong>Dry feeders stop at pounds.</strong> For powder or gas, use the
        active lb/day and set strength to 100%. Gallons and mL/min don't
        apply.
      </li>
      <li>
        <strong>Prove it with a drawdown.</strong> Pump dials drift. Time the
        drop in the calibration column and compare it to the mL/min here.
      </li>
    </ul>
    <p class="disclaimer">
      This is a study and planning aid. Your plant's SOPs, permit and the
      product's SDS take priority over any number on this page.
    </p>
  </section>
</section>

<script>
  import {
    calculateDosage,
    chemicalPresets,
    formatNumber,
    type DosageInput,
    type FlowUnit,
  } from "@/lib/dosage";

  const exampleValues = { preset: "hypo", dose: "6", flow: "4", flowUnit: "mgd", strength: "12.5", specificGravity: "1.2" };

  function bind() {
    const form = document.querySelector<HTMLFormElement>("[data-dosage-calc]");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const field = <T extends HTMLInputElement | HTMLSelectElement>(name: string) =>
      form.elements.namedItem(name) as T;
    const preset = field<HTMLSelectElement>("preset");
    const strength = field<HTMLInputElement>("strength");
    const sg = field<HTMLInputElement>("specificGravity");
    const error = form.querySelector<HTMLElement>("[data-error]")!;
    const results = form.querySelector<HTMLElement>("[data-results]")!;
    const steps = document.querySelector<HTMLElement>("[data-steps]")!;

    const read = (name: string) => {
      const raw = field<HTMLInputElement>(name).value.trim();
      return raw === "" ? NaN : Number(raw);
    };
    const setMath = (key: string, html: string) => {
      const el = steps.querySelector<HTMLElement>(`[data-math="${key}"]`);
      if (el) el.innerHTML = html;
    };
    const showStep = (key: string, show: boolean) => {
      const el = steps.querySelector<HTMLElement>(`[data-step="${key}"]`);
      if (el) el.hidden = !show;
    };

    function update() {
      const input: DosageInput = {
        dose: read("dose"),
        flow: read("flow"),
        flowUnit: field<HTMLSelectElement>("flowUnit").value as FlowUnit,
        strength: read("strength"),
        specificGravity: read("specificGravity"),
      };
      const outcome = calculateDosage(input);

      error.hidden = outcome.ok;
      results.classList.toggle("is-stale", !outcome.ok);
      steps.classList.toggle("is-stale", !outcome.ok);
      if (!outcome.ok) {
        error.textContent = outcome.message;
        return;
      }

      const r = outcome.result;
      const f = formatNumber;
      for (const out of results.querySelectorAll<HTMLOutputElement>("[data-out]")) {
        out.value = f(r[out.dataset.out as keyof typeof r]);
      }

      const flowFormula: Record<FlowUnit, string> = {
        mgd: "",
        gpm: `${f(input.flow)} gpm × 1,440 ÷ 1,000,000 = <b>${f(r.flowMgd)} MGD</b>`,
        gpd: `${f(input.flow)} gal/day ÷ 1,000,000 = <b>${f(r.flowMgd)} MGD</b>`,
      };
      const isPure = input.strength === 100;
      showStep("flow", input.flowUnit !== "mgd");
      showStep("strength", !isPure);
      setMath("flow", flowFormula[input.flowUnit]);
      setMath("active", `${f(input.dose)} mg/L × ${f(r.flowMgd)} MGD × 8.34 = <b>${f(r.activeLbPerDay)} lb/day</b>`);
      setMath("strength", `${f(r.activeLbPerDay)} ÷ ${input.strength / 100} = <b>${f(r.productLbPerDay)} lb/day</b> of product`);
      setMath("weight", `8.34 × ${f(input.specificGravity)} = <b>${f(r.productLbPerGal, 2)} lb/gal</b>`);
      setMath("gallons", `${f(r.productLbPerDay)} ÷ ${f(r.productLbPerGal, 2)} = <b>${f(r.productGalPerDay)} gal/day</b>`);
      setMath("pump", `${f(r.productGalPerDay)} gal/day × 3,785 mL/gal ÷ 1,440 min/day = <b>${f(r.productMlPerMin)} mL/min</b>`);
    }

    preset.addEventListener("change", () => {
      const p = chemicalPresets.find((c) => c.id === preset.value);
      if (p) {
        strength.value = String(p.strength);
        sg.value = String(p.specificGravity);
      }
      update();
    });

    // Hand-editing strength or SG means it's no longer the preset product.
    for (const input of [strength, sg]) {
      input.addEventListener("input", () => {
        const p = chemicalPresets.find((c) => c.id === preset.value);
        if (p && (Number(strength.value) !== p.strength || Number(sg.value) !== p.specificGravity)) {
          preset.value = "custom";
        }
      });
    }

    form.addEventListener("input", update);
    form.addEventListener("change", update);
    form.addEventListener("submit", (e) => e.preventDefault());

    document.querySelector("[data-load-example]")?.addEventListener("click", () => {
      for (const [name, value] of Object.entries(exampleValues)) {
        field<HTMLInputElement>(name).value = value;
      }
      update();
      form.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    update();
  }

  bind();
  document.addEventListener("astro:page-load", bind);
</script>
