---
import { conversionGroups, conversions } from "../../data/conversions";
import { fromToUnitIdMap } from "../../lib/conversions";
import ConversionBar from "./ConversionBar.astro";

const grouped = conversionGroups.map((group) => ({
  group,
  items: conversions.filter((c) => c.group === group.id),
}));
---

<section class="or-page" aria-label="Conversion factors">
  <ConversionBar />

  {
    grouped.map(({ group, items }) => (
      <section class="conv-group" aria-labelledby={`c-${group.id}`}>
        <h2 id={`c-${group.id}`}>{group.name}</h2>
        <ul class="conv-list">
          {items.map((c) => {
            const unitId = fromToUnitIdMap.get(c.from);
            return (
              <li
                class={`conv-row ${unitId ? "conv-row-clickable" : ""}`}
                data-conv-trigger={unitId}
                title={unitId ? `Click to convert ${c.from} in Quick Converter` : undefined}
              >
                <span class="conv-from">{c.from}</span>
                <span class="conv-to">
                  {c.to.map((value) => (
                    <span class="conv-value">{value}</span>
                  ))}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</section>

<style>
  .or-page {
    --ink: var(--fg-ink);
    --muted: var(--fg-muted);
    --line: var(--fg-line);

    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) 3rem;
    color: var(--ink);
    font-family: var(--fg-font);
  }

  .conv-group + .conv-group {
    margin-top: 2rem;
  }

  .conv-group h2 {
    margin: 0 0 0.75rem;
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .conv-list {
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--fg-paper);
    list-style: none;
    overflow: hidden;
  }

  .conv-row {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    gap: 0.4rem 1rem;
    align-items: baseline;
    padding: 0.7rem 0.95rem;
    transition: background-color 0.15s ease;
  }

  .conv-row-clickable {
    cursor: pointer;
  }

  .conv-row-clickable:hover {
    background: color-mix(in srgb, var(--fg-teal) 5%, var(--fg-paper));
  }

  .conv-row + .conv-row {
    border-top: 1px solid var(--line);
  }

  .conv-from {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .conv-to {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
  }

  .conv-value {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--fg-teal) 6%, transparent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 34rem) {
    .conv-row {
      grid-template-columns: 1fr;
    }
  }
</style>
