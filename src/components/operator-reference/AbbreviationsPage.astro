---
import { abbreviations } from "../../data/abbreviations";
---

<section class="or-page" aria-label="Abbreviations">
  <div class="or-filter">
    <label class="or-filter-label" for="abbrev-filter">Filter abbreviations</label>
    <div class="or-filter-row">
      <input
        id="abbrev-filter"
        type="search"
        placeholder="Try “MLSS”, “sludge”, “per day”…"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="or-filter-clear" hidden>Clear</button>
    </div>
    <p class="or-filter-count" role="status" aria-live="polite"></p>
  </div>

  <dl class="abbrev-list">
    {
      abbreviations.map((a) => (
        <div
          class="abbrev-row"
          data-search={`${a.short} ${a.long}`.toLowerCase()}
        >
          <dt>{a.short}</dt>
          <dd>{a.long}</dd>
        </div>
      ))
    }
  </dl>

  <p class="or-empty" hidden>No abbreviation matches that search.</p>
</section>

<script>
  function initAbbrevFilter() {
    const input = document.getElementById("abbrev-filter");
    if (!(input instanceof HTMLInputElement)) return;
    if (input.dataset.bound === "true") return;
    input.dataset.bound = "true";

    const root = input.closest(".or-page");
    if (!root) return;

    const clear = root.querySelector(".or-filter-clear");
    const count = root.querySelector(".or-filter-count");
    const empty = root.querySelector(".or-empty");
    const rows = Array.from(root.querySelectorAll(".abbrev-row"));
    const total = rows.length;

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;

      for (const row of rows) {
        const match = q === "" || (row.getAttribute("data-search") ?? "").includes(q);
        row.toggleAttribute("hidden", !match);
        if (match) shown += 1;
      }

      if (clear) clear.toggleAttribute("hidden", q === "");
      if (empty) empty.toggleAttribute("hidden", shown !== 0);
      if (count) {
        count.textContent =
          q === "" ? `${total} abbreviations` : `${shown} of ${total} abbreviations`;
      }
    };

    input.addEventListener("input", apply);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && input.value !== "") {
        event.stopPropagation();
        input.value = "";
        apply();
      }
    });
    clear?.addEventListener("click", () => {
      input.value = "";
      apply();
      input.focus();
    });

    apply();
  }

  initAbbrevFilter();
  document.addEventListener("astro:page-load", initAbbrevFilter);
</script>

<style>
  .or-page {
    --ink: var(--fg-ink);
    --muted: var(--fg-muted);
    --line: var(--fg-line);

    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) 3rem;
    color: var(--ink);
    font-family: var(--fg-font);
  }




  .or-filter {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-bottom: 1.5rem;
    padding: 0.85rem 0 0.75rem;
    background: var(--fg-canvas);
  }

  .or-filter-label {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .or-filter-row {
    display: flex;
    gap: 0.5rem;
  }

  .or-filter input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--fg-paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 1rem;
  }

  .or-filter input:focus-visible {
    outline: 2px solid var(--fg-teal);
    outline-offset: 1px;
  }

  .or-filter-clear {
    flex: none;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--fg-paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 650;
    cursor: pointer;
  }

  .or-filter-clear:hover {
    border-color: var(--fg-teal);
  }

  .or-filter-count {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .abbrev-list > :global(*) {
    /* Starlight's markdown flow adds margin-top to every sibling, which staggers grid rows. */
    margin-top: 0;
  }

  .abbrev-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--fg-paper);
    overflow: hidden;
  }

  .abbrev-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--line);
  }

  .abbrev-row[hidden] {
    display: none;
  }

  .abbrev-row:first-child {
    border-top: 0;
  }

  .abbrev-row dt {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 750;
  }

  .abbrev-row dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .or-empty {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  [hidden] {
    display: none !important;
  }
</style>
