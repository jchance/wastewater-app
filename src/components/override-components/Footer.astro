---
import config from "@/config/config.json";
import { markdownify } from "@/lib/utils/textConverter";
import { getTranslations } from "@/lib/utils/languagePerser";

const locale = Astro.currentLocale;

const menu = await getTranslations(locale || "en");

const footer = menu.footer;
const hasFooterLinks =
  [footer.community, footer.help_links, footer.company].some(
    (section: any) => section?.links?.length,
  ) || config?.params?.footer_contact?.enable;
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    {hasFooterLinks && (
    <div class="top-footer">
      {
        footer.community && (
          <div>
            <h4>{footer.community.title}</h4>
            <ul>
              {footer.community?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        footer.help_links && (
          <div>
            <h4>{footer.help_links.title}</h4>
            <ul>
              {footer.help_links?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        footer.company && (
          <div>
            <h4>{footer.company.title}</h4>
            <ul>
              {footer.company?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        config?.params?.footer_contact?.enable && (
          <div>
            <h4>Connect With Us</h4>
            <form
              action={config?.params?.footer_contact?.action}
              class="mail-form"
            >
              <input type="email" placeholder="Enter your email" required />
              <button type="submit" aria-label="Submit email">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M21.0477 3.05293C18.8697 0.707361 2.48648 6.4532 2.50001 8.551C2.51535 10.9299 8.89809 11.6617 10.6672 12.1581C11.7311 12.4565 12.016 12.7625 12.2613 13.8781C13.3723 18.9305 13.9301 21.4435 15.2014 21.4996C17.2278 21.5892 23.1733 5.342 21.0477 3.05293Z"
                    class="stroke-black dark:stroke-white"
                    stroke-width="1.5"
                  />
                  <path
                    d="M11.5 12.5L15 9"
                    class="stroke-black dark:stroke-white"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </form>

          </div>
        )
      }
    </div>
    )}
    <div class="bottom-footer">
      <p class="footer-disclaimer">
        Formulas follow the conventions used on WPI operator certification
        formula sheets. Typical ranges, presets, and example values are general
        guidance, not your plant's numbers. Check results against your own
        plant data, permit limits, SOPs, and O&amp;M manual, and confirm with your
        supervisor or engineer before changing anything.
      </p>
      <div class="footer-meta">
        <a
          href="https://github.com/jchance/wastewater-app"
          target="_blank"
          rel="noopener"
          class="github-btn"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.165c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.37-12-12-12z"
            ></path>
          </svg>
          View on GitHub
        </a>
        <p class="footer-copyright">
          Wastewater Field Guide &copy; {year} <a href="https://jasonchance.com" target="_blank" rel="noopener">Jason Chance</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Unlayered so global paragraph styles don't override them. */
  .footer-disclaimer {
    max-width: 68ch;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .footer-copyright {
    margin: 0;
    font-size: 0.875rem;
  }
  .footer-copyright a {
    color: var(--fg-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--fg-teal) 40%, var(--fg-line));
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .footer-copyright a:hover,
  .footer-copyright a:focus-visible {
    color: var(--fg-teal);
    text-decoration-color: var(--fg-teal);
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .github-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--fg-line);
    border-radius: 0.5rem;
    background: var(--fg-paper);
    color: var(--fg-body);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }
  .github-btn:hover,
  .github-btn:focus-visible {
    color: var(--fg-teal);
    border-color: var(--fg-teal);
    background: color-mix(in srgb, var(--fg-teal) 10%, var(--fg-paper));
  }
  @media (min-width: 50rem) {
    .footer-meta {
      align-items: flex-end;
    }
  }

  @layer starlight.core {
    .top-footer {
      border-bottom: 1px solid var(--fg-line);
      padding: 60px 0;
      display: grid;
      gap: 2rem;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .top-footer h4 {
      font-size: 1rem !important;
      margin-bottom: 4rem;
      color: var(--fg-ink);
    }
    .top-footer ul {
      list-style: none;
      padding: 0;
    }
    .top-footer ul li {
      margin-bottom: 1.2rem;
    }
    .top-footer ul li a {
      color: var(--fg-body);
      text-decoration: none;
      font-size: 1rem;
      transition: color 0.3s ease;
    }
    .top-footer ul li a:hover {
      color: var(--fg-teal);
    }
    .mail-form {
      border: 1px solid var(--fg-line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 12px;
      padding: 0.5rem 0.8rem;
      background-color: var(--fg-paper);
    }
    .mail-form input {
      background-color: transparent;
      width: 90%;
    }
    .mail-form input:focus {
      outline: none;
    }
    .mail-form button {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: transparent;
      cursor: pointer;
    }
    .social-icons {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }
    .social-icons li a {
      background: color-mix(in srgb, var(--sl-color-gray-4) 20%, transparent);
      width: 45px;
      height: 45px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.6s ease;
    }
    .social-icons li a:hover {
      background: var(--fg-teal);
      color: white !important;
    }

    .bottom-footer {
      padding: 32px 0;
      border-top: 1px solid var(--fg-line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      color: var(--fg-muted);
    }
    .bottom-footer a {
      color: var(--fg-body);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .bottom-footer a:hover {
      color: var(--fg-teal);
    }
  }
</style>
