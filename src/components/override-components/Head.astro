---
import { getEntry } from "astro:content";
import { SHARE_IMAGE_HEIGHT, SHARE_IMAGE_WIDTH } from "@/lib/shareImage";

const { head, entry } = Astro.locals.starlightRoute;
// Built by src/pages/og/[...slug].png.ts. Pages outside the docs collection
// (the app's section lists) fall back to the home page card.
const shareImageId = entry.id && (await getEntry("docs", entry.id)) ? entry.id : "index";
const shareImage = new URL(`/og/${shareImageId}.png`, Astro.site).href;
const shareImageAlt = `${entry.data.title}, from the Wastewater Field Guide`;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={shareImageAlt} />
<meta name="twitter:image" content={shareImage} />
<meta name="twitter:image:alt" content={shareImageAlt} />

<script is:inline>
  // Registered on every page so the guide keeps working after the operator
  // walks into a dead spot, whether or not they installed it.
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker
        .register("/sw.js")
        .then((reg) => {
          // A new build was deployed: let it take over immediately instead of
          // waiting for every tab to close, but never reload out from under
          // someone who is mid-calculation. The next navigation gets it.
          reg.addEventListener("updatefound", () => {
            const next = reg.installing;
            if (!next) return;
            next.addEventListener("statechange", () => {
              if (next.state === "installed" && navigator.serviceWorker.controller) {
                next.postMessage("skip-waiting");
              }
            });
          });
          reg.update();
        })
        .catch(() => {});
    });
  }
</script>
