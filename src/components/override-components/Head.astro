---
import { AstroFont } from "astro-font";
import theme from "@/config/theme.json";
const { head } = Astro.locals.starlightRoute;

// font families
const pf = theme.fonts.font_family.primary;
// @ts-ignore
const sf = theme.fonts.font_family.secondary ;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}
// @ts-ignore
if (theme.fonts.font_family.secondary) {
// @ts-ignore
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}

---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script is:inline>
  // Registered on every page so the guide keeps working after the operator
  // walks into a dead spot, whether or not they installed it.
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker
        .register("/sw.js")
        .then((reg) => {
          // A new build was deployed: let it take over immediately instead of
          // waiting for every tab to close, but never reload out from under
          // someone who is mid-calculation. The next navigation gets it.
          reg.addEventListener("updatefound", () => {
            const next = reg.installing;
            if (!next) return;
            next.addEventListener("statechange", () => {
              if (next.state === "installed" && navigator.serviceWorker.controller) {
                next.postMessage("skip-waiting");
              }
            });
          });
          reg.update();
        })
        .catch(() => {});
    });
  }
</script>

<!-- google font css -->
{
  fontPrimary && (
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary,
          fallback: "sans-serif" as const,
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        ...(fontSecondary
          ? [
              {
                src: [],
                preload: false,
                display: "swap" as const,
                name: fontSecondary,
                fallback: "sans-serif" as const,
                cssVariable: "font-secondary",
                googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
              },
            ]
          : []),
      ]}
    />
  )
}
