---
import { pageFamily } from "@/lib/utils/pageFamily";

const { id, data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
const { kicker } = data;
---

<header class="page-intro page-column" data-family={pageFamily(id)}>
  {kicker && <p class="page-kicker">{kicker}</p>}
  {title && <h1 set:html={title} />}
  {tagline && <p class="page-lede" set:html={tagline} />}
</header>

<style>
  .page-intro {
    padding-top: clamp(1.25rem, 3vw, 2rem);
    color: var(--fg-ink);
    font-family: var(--fg-font);
  }

  .page-kicker {
    margin: 0 0 0.6rem;
    color: var(--fg-teal-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 !important;
    color: var(--fg-ink) !important;
    font-size: clamp(1.75rem, 4vw, 2.6rem) !important;
    font-weight: 750;
    letter-spacing: -0.035em !important;
    line-height: 1.12 !important;
    text-wrap: balance;
  }

  .page-lede {
    max-width: 46rem;
    margin: 0.75rem 0 0;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .page-lede :global(strong) {
    color: var(--fg-ink);
  }

  .page-lede :global(a) {
    color: var(--fg-teal);
    font-weight: 650;
  }
</style>
